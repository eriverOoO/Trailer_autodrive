<mvsim_world version="1.0">
    <!-- Flat asphalt lot for tractor/trailer parallel parking and 2D lidar SLAM.
         Coordinates: driving direction +X; parking bay on the right (-Y).
         One 6.67 x 2.2 m bay: x=5.365..12.035, y=-5.5..-3.3.
         Measured straight vehicle span (including wheels): x=-2.685..1.360
         relative to tractor, width=1.31 m. -->
    <simul_timestep>5e-3</simul_timestep>
    <gravity>9.81</gravity>
    <b2d_vel_iters>10</b2d_vel_iters>
    <b2d_pos_iters>5</b2d_pos_iters>
    <gui><ortho>true</ortho><cam_distance>65</cam_distance><cam_azimuth>180</cam_azimuth><cam_elevation>90</cam_elevation><cam_point_to>8.0375 -0.5 0</cam_point_to><start_maximized>false</start_maximized><win_w>1100</win_w><win_h>850</win_h></gui>

    <!-- The asphalt is level and the white lines are visual only. -->
    <element class="horizontal_plane">
        <x_min>-24</x_min><x_max>30</x_max>
        <y_min>-17</y_min><y_max>17</y_max>
        <z>0</z>
        <texture>/home/venezuelachocolatemilk/mvsim_slam/mvsim_slam_final/models/parking_asphalt.png</texture>
        <texture_size_x>5</texture_size_x>
        <texture_size_y>5</texture_size_y>
    </element>

    <!-- Only the middle bay is marked. These planes are visual, not collision bodies. -->
    <element class="visual_paint"><x_min>5.365</x_min><x_max>12.035</x_max><y_min>-5.54</y_min><y_max>-5.46</y_max><z>0.015</z><color>#ffffff</color></element>
    <element class="visual_paint"><x_min>5.365</x_min><x_max>12.035</x_max><y_min>-3.34</y_min><y_max>-3.26</y_max><z>0.015</z><color>#ffffff</color></element>
    <element class="visual_paint"><x_min>5.325</x_min><x_max>5.405</x_max><y_min>-5.5</y_min><y_max>-3.3</y_max><z>0.015</z><color>#ffffff</color></element>
    <element class="visual_paint"><x_min>11.995</x_min><x_max>12.075</x_max><y_min>-5.5</y_min><y_max>-3.3</y_max><z>0.015</z><color>#ffffff</color></element>
    <element class="visual_paint"><x_min>-18</x_min><x_max>25</x_max><y_min>1.8</y_min><y_max>1.86</y_max><z>0.015</z><color>#d0d0b0</color></element>

    <!-- Blue inner faces coincide with the white OUTER edges:
         x=5.325 / 12.075 and rear y=-5.54 (0.04 m outside centerlines).
         Side blocks retain 10.0 m thickness and extend rearward to -6.14.
         The 0.60 m thick back wall abuts the side faces without overlap.
         Entrance y=-3.3 stays open; marked bay is 6.67 x 2.2 m. -->
    <block:class name="parking_back_wall_class">
        <static>true</static><color>#2457C5</color><zmin>0</zmin><zmax>1.90</zmax>
        <shape><pt>-3.375 -0.30</pt><pt>3.375 -0.30</pt><pt>3.375 0.30</pt><pt>-3.375 0.30</pt></shape>
    </block:class>
    <block:class name="parking_side_wall_class">
        <static>true</static><color>#2457C5</color><zmin>0</zmin><zmax>1.90</zmax>
        <shape><pt>-5.0 -1.42</pt><pt>5.0 -1.42</pt><pt>5.0 1.42</pt><pt>-5.0 1.42</pt></shape>
    </block:class>
    <block:class name="parking_lower_extended_class">
        <static>true</static><color>#2457C5</color><zmin>0</zmin><zmax>1.90</zmax>
        <shape><pt>-6.325 -1.42</pt><pt>5.0 -1.42</pt><pt>5.0 1.42</pt><pt>-6.325 1.42</pt></shape>
    </block:class>
    <block name="parking_left_wall" class="parking_lower_extended_class"><init_pose>0.325 -4.72 0</init_pose></block>
    <block name="parking_right_wall" class="parking_side_wall_class"><init_pose>17.075 -4.72 0</init_pose></block>
    <block name="parking_back_wall" class="parking_back_wall_class"><init_pose>8.7 -5.84 0</init_pose></block>

	<!-- ======================== Tractor (driven) ======================== -->
	<vehicle:class name="tractor_class">
		<dynamics class="ackermann">
			<!-- Rear wheels -->
			<rl_wheel pos="0  0.53" mass="5.0" width="0.25" diameter="0.70">
			<visual> <model_uri>/home/venezuelachocolatemilk/mvsim_slam/mvsim_slam_final/models/tractor-trailer-kidbi/tractor_rear_wheel.fbx</model_uri> <model_scale>1e-2</model_scale> <model_yaw>90.0</model_yaw> </visual>
			</rl_wheel>

			<rr_wheel pos="0 -0.53" mass="5.0" width="0.25" diameter="0.70">
			<visual> <model_uri>/home/venezuelachocolatemilk/mvsim_slam/mvsim_slam_final/models/tractor-trailer-kidbi/tractor_rear_wheel.fbx</model_uri> <model_scale>1e-2</model_scale> <model_yaw>90.0</model_yaw> </visual>
			</rr_wheel>

			<!-- Front wheels -->
			<fl_wheel mass="5.0" width="0.25" diameter="0.46">
			<visual> <model_uri>/home/venezuelachocolatemilk/mvsim_slam/mvsim_slam_final/models/tractor-trailer-kidbi/tractor_front_wheel.fbx</model_uri> <model_scale>1e-2</model_scale> <model_yaw>90.0</model_yaw> </visual>
			</fl_wheel>

			<fr_wheel mass="5.0" width="0.25" diameter="0.46">
			<visual> <model_uri>/home/venezuelachocolatemilk/mvsim_slam/mvsim_slam_final/models/tractor-trailer-kidbi/tractor_front_wheel.fbx</model_uri> <model_scale>1e-2</model_scale> <model_yaw>90.0</model_yaw> </visual>
			</fr_wheel>

			<f_wheels_x>1.13</f_wheels_x>
			<f_wheels_d>0.82</f_wheels_d>
			<max_steer_ang_deg>35.0</max_steer_ang_deg>

			<chassis mass="500.0" zmin="0.20" zmax="1.50">
	            <shape_from_visual/> <!-- automatic shape,zmin,zmax from 3D mesh-->
			</chassis>

			<!-- Motor controller -->
			<controller class="twist_ideal">
			</controller>

		</dynamics>

		<friction class="default">
			<mu>0.8</mu>
			<C_damping>5</C_damping>
			<C_rr>0.01</C_rr>  <!-- Rolling resistance coefficient -->
		</friction>

		<!-- Noisy odometry parameters. These are multipliers to actual SE(2) increments -->
		<odometry
			x_multiplier="$f{1.0+0.02*randn()}"
			y_multiplier="$f{1.0+0.01*randn()}"
			yaw_multiplier="$f{1.0+0.03*randn()}"
		/>

		<!--  Custom vehicle visualization model -->
		<!-- 3D model filename to load (local or remote http://uri ) -->
		<visual>
			<model_uri>/home/venezuelachocolatemilk/mvsim_slam/mvsim_slam_final/models/tractor-trailer-kidbi/tractor_body.fbx</model_uri>
			<model_scale>1e-2</model_scale>
			<model_yaw>90.0</model_yaw>
			<model_roll>90.0</model_roll>
		</visual>

	</vehicle:class>

	<vehicle name="tractor" class="tractor_class">
		<init_pose>-2 0 0</init_pose>
        <!-- White roof top at x=-0.05,y=0 is z=1.3816 m; lidar model bottom is z=0. -->
        <!-- Removed: sensor runtime is isolated; no IMU. -->
        <!-- Red bonnet top at x=0.85,y=0 is z=0.8912 m; IMU bottom is -0.00274 m. -->
        <!-- Removed: sensor runtime is isolated; no IMU. -->
	</vehicle>

	<!-- ======================== Trailer (passive) ======================== -->
	<vehicle:class name="trailer_class">

	<!-- Can use 'differential_4_wheels' for trailer with 4 wheels -->

	<dynamics class="differential">
		<!-- 2 passive wheels -->
			<l_wheel pos="-1.33  0.4" mass="4.0" width="0.22" diameter="0.50">
			<visual> <model_uri>/home/venezuelachocolatemilk/mvsim_slam/mvsim_slam_final/models/tractor-trailer-kidbi/trailer_wheel.fbx</model_uri> <model_scale>1e-2</model_scale> <model_yaw>90.0</model_yaw> </visual>
			</l_wheel>
			<r_wheel pos="-1.33 -0.4" mass="4.0" width="0.22" diameter="0.50">
			<visual> <model_uri>/home/venezuelachocolatemilk/mvsim_slam/mvsim_slam_final/models/tractor-trailer-kidbi/trailer_wheel.fbx</model_uri> <model_scale>1e-2</model_scale> <model_yaw>90.0</model_yaw></visual>
			</r_wheel>

			<chassis mass="300.0" zmin="0.30" zmax="2.00">
				<shape_from_visual/> <!-- automatic shape,zmin,zmax from 3D mesh-->
			</chassis>

			<!--
			     IMPORTANT: Use "raw" controller with zero torque to make
			     this a passive (unpowered) vehicle. The trailer is pulled
			     entirely by the tractor through the pin joint.
			-->
			<controller class="raw">
			</controller>
		</dynamics>

		<!-- Low friction for passive rolling -->
		<friction class="default">
			<mu>0.8</mu>
			<C_damping>0.1</C_damping>
			<C_rr>0.01</C_rr>  <!-- Rolling resistance coefficient -->
		</friction>

		<!--  Custom vehicle visualization model -->
		<!-- 3D model filename to load (local or remote http://uri ) -->
		<visual>
			<model_uri>/home/venezuelachocolatemilk/mvsim_slam/mvsim_slam_final/models/tractor-trailer-kidbi/trailer_body.fbx</model_uri>
			<model_scale>1e-2</model_scale>
			<model_yaw>90.0</model_yaw>
			<model_roll>90.0</model_roll>
		</visual>

	</vehicle:class>

	<vehicle name="trailer" class="trailer_class">
		<!-- Place it behind the tractor.
		     The tractor rear axle is at x=0 -->
		<init_pose>-2.524 0 0</init_pose>
        <!-- Open cargo bed has no central upper deck. Mount on the red front
             crossbar center: top z=1.1553 m, IMU bottom z=-0.00274 m. -->
        <!-- Removed: sensor runtime is isolated; no IMU. -->
	
        <sensor class="imu" name="imu_trailer">
            <pose_3d>-0.32 0 1.178 0 0 0</pose_3d>
            <sensor_period>0.01</sensor_period>
            <angular_velocity_white_noise_std_noise>0.0002</angular_velocity_white_noise_std_noise>
            <angular_velocity_random_walk_std_noise>0</angular_velocity_random_walk_std_noise>
            <measure_orientation>false</measure_orientation>
        </sensor>
</vehicle>


	<!-- ======================== Pin joint (hitch) ======================== -->
	<!--
	     Connects the rear of the tractor to the front of the trailer.
	     - Tractor: anchor at x=-0.524 (behind rear axle), y=0 (centerline)
	     - Trailer: anchor at x=0.0, y=0 (centerline)
	     - The revolute joint allows free rotation (like a real hitch pin).
	     - Optional: enable_limit with angle bounds to prevent jack-knifing.
	-->
	<joint type="revolute"
		body_a="tractor"  anchor_a="-0.524 0.0"
		body_b="trailer"  anchor_b="0.0 0.0"
		enable_limit="true"
		lower_angle_deg="-45"
		upper_angle_deg="45"
	/>
	<!-- ======================== Example rope joint (commented out) ======= -->
	<!-- Uncomment to add a rope between two vehicles instead of a pin:
	<joint type="distance"
		body_a="tractor"  anchor_a="-0.524 0.0"
		body_b="trailer"  anchor_b="0.0 0.0"
		max_length="3.5"
		min_length="0.0"
		stiffness="0.0"
		damping="0.0"
	/>
	-->

<block:class name="set_opposite_wall_class"><static>true</static><color>#2457C5</color><zmin>0</zmin><zmax>1.90</zmax><shape><pt>-6 4.5</pt><pt>22.075 4.5</pt><pt>22.075 4.9</pt><pt>-6 4.9</pt></shape></block:class>
<block name="set_opposite_wall" class="set_opposite_wall_class"><init_pose>0 0 0</init_pose></block>
<block:class name="set_rear_cap_class"><static>true</static><color>#2457C5</color><zmin>0</zmin><zmax>1.90</zmax><shape><pt>-6.4 -6.14</pt><pt>-6 -6.14</pt><pt>-6 4.9</pt><pt>-6.4 4.9</pt></shape></block:class>
<block name="set_rear_cap" class="set_rear_cap_class"><init_pose>0 0 0</init_pose></block>
<block:class name="set_front_cap_class"><static>true</static><color>#2457C5</color><zmin>0</zmin><zmax>1.90</zmax><shape><pt>22.075 -6.14</pt><pt>22.475 -6.14</pt><pt>22.475 4.9</pt><pt>22.075 4.9</pt></shape></block:class>
<block name="set_front_cap" class="set_front_cap_class"><init_pose>0 0 0</init_pose></block>
</mvsim_world>
