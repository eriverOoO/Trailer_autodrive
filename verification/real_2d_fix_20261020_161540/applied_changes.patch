+# Display only. A sensor-anchored icon is NOT a measured rear-axle pose.
+mode: LIVE
+visualization_mode: TRACTOR_ONLY_DIAGNOSTIC
+namespace: /vehicle_viz_2d
+fixed_frame: map
+slam_frame: laser_frame
+imu_timeout_s: 0.5
+pose_timeout_s: 0.5
+max_pair_skew_s: 0.05
+geometry:
+  confirmed: false
