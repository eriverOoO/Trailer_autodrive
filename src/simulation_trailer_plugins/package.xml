<?xml version="1.0"?>
<package format="3">
  <name>simulation_trailer_plugins</name>
  <version>1.0.0</version>
  <description>Gazebo Classic physical hitch joint for the Prius towing simulation.</description>
  <maintainer email="012vision@gmail.com">Jinsun-Lee</maintainer>
  <license>GNU-GPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>gazebo_dev</depend>
  <depend>gazebo_ros</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros plugin_path="${prefix}/../../lib"/>
  </export>
</package>
